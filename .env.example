# ---------------------------------------------------------------------------
# CORPUS — example environment file.
#
# Copy to `.dev.vars` for local `wrangler dev`, or `.env` for scripts/tests.
# NEVER commit real secrets. In production use `wrangler secret put NAME`.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=debug
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DEFAULT_TENANT_SLUG=default

# --- Secrets (SECRET) --------------------------------------------------------
# Sign/verify dashboard sessions. Generate: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# --- Telegram (SECRET) -------------------------------------------------------
# Two separate bots. Create both with @BotFather.
TELEGRAM_EXTERNAL_BOT_TOKEN=
TELEGRAM_INTERNAL_BOT_TOKEN=
# Shared secret echoed back by Telegram in X-Telegram-Bot-Api-Secret-Token.
# Generate one per bot: openssl rand -hex 32
TELEGRAM_EXTERNAL_WEBHOOK_SECRET=
TELEGRAM_INTERNAL_WEBHOOK_SECRET=

# --- AI provider -------------------------------------------------------------
# One of: mock | workers-ai | google | anthropic | openai | compatible
#
#   mock        offline, deterministic. The default for local dev and tests —
#               no key, no network. Refused in production.
#   workers-ai  FREE, no API key and no external account. Runs on Cloudflare's
#               [ai] binding inside the same free tier as the Worker. This is
#               the production default in wrangler.toml.
#                 AI_MODEL=@cf/meta/llama-3.1-8b-instruct   (tool calling)
#   google      FREE tier, needs an API key from https://aistudio.google.com
#               (no billing account required).
#                 AI_MODEL=gemini-2.0-flash
#   anthropic   PAID.  AI_MODEL=claude-haiku-4-5-20251001
#   openai      PAID.  AI_MODEL=gpt-4o-mini
#   compatible  Any OpenAI-shaped endpoint; set AI_BASE_URL too.
#
# Only google/anthropic/openai/compatible need AI_API_KEY. Never commit it —
# in production use: wrangler secret put AI_API_KEY
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Cost/quota controls. These matter most on the free providers, whose limits
# are a daily allowance rather than a bill (CLAUDE.md §37).
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_CONTEXT_CHUNKS=5
AI_REQUESTS_PER_HOUR=60

# --- Limits and rate limits ---------------------------------------------------
# All optional; the defaults shown are what the code uses when unset
# (packages/shared/src/config.ts). Rate limits are per the window named in the
# key, and are configurable per deployment as CLAUDE.md §45 requires.

# Request/upload ceilings (CLAUDE.md §52).
MAX_UPLOAD_BYTES=8388608
MAX_REQUEST_BODY_BYTES=524288
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=25

# Per-user / per-IP rate limits. The public and Telegram buckets key on
# CF-Connecting-IP or the Telegram user id; X-Forwarded-For is never trusted.
RATE_LIMIT_TELEGRAM_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_15M=10
RATE_LIMIT_VERIFY_PER_15M=5
RATE_LIMIT_APPLICATIONS_PER_HOUR=5
RATE_LIMIT_ADMIN_API_PER_MINUTE=600
RATE_LIMIT_PUBLIC_API_PER_MINUTE=120

# --- Local development database ---------------------------------------------
# Used by scripts/migrate.ts, scripts/seed.ts and the integration tests.
LOCAL_DB_PATH=./data/corpus.sqlite

# --- Local seed bootstrap ----------------------------------------------------
# Password assigned to seeded development accounts. Development data only.
SEED_ADMIN_EMAIL=admin@corpus.test
SEED_PASSWORD=DevPassword123!

# --- Tooling (read by scripts, not by the Worker) -----------------------------
# Public HTTPS base URL of the deployed Worker, used by scripts/telegram-setup.ts
# to register the Telegram webhooks. Leave unset during local development: the
# script auto-detects a running `cloudflared tunnel --url http://127.0.0.1:8787`
# and prefers it, because a quick tunnel is issued a new hostname on every
# restart. Put this in `.env` rather than `.dev.vars` — it is not a Worker var.
API_BASE_URL=
